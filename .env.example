# Optional for the application shell; required only by npm run check:supabase.
# Keep actual values in ignored .env.local. No browser exposure in Phase 1.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional public HTTPS origin for production metadata/canonicals. Never a credential.
# Local uses localhost; Vercel Preview uses its supplied deployment origin and stays noindex.
SITE_URL=
