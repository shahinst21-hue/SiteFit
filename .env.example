# Required for development authentication; public pages still build without configuration.
# Keep actual values in ignored .env.local. These two publishable values are deliberately
# passed to the browser on the login page. Never use a secret/service-role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional public HTTPS origin for production metadata/canonicals. Never a credential.
# Local uses localhost; Vercel Preview uses its supplied deployment origin and stays noindex.
SITE_URL=

# Phase 4 server-only address lookup. Blank provider uses postio; never use a public prefix.
ADDRESS_LOOKUP_PROVIDER=
POSTIO_API_KEY=

# Trusted canonical-property writes only; separate from publishable Auth configuration.
# Store a development Supabase secret key securely, never in browser props or source.
SUPABASE_SECRET_KEY=

# Phase 5 internal development proof only; server-side, never NEXT_PUBLIC.
TFL_APP_KEY=

# Phase 8 approved development enrichment; server-only, never NEXT_PUBLIC.
# PropertyData trial access needs owner approval; no automatic subscription purchase.
PROPERTYDATA_API_KEY=
# Geoapify Free; Local initially, protected Preview only when explicitly configured.
GEOAPIFY_API_KEY=
# Official non-domestic EPC fallback; permitted non-address fields only.
EPC_API_TOKEN=

# Phase 6 server-only section analysis. Preview only until Production is separately authorised.
# Owner requires GPT 6.1 Sol; never use NEXT_PUBLIC or commit an actual value.
OPENAI_API_KEY=

# Test Mode is localhost/protected Preview only. Production uses separately
# approved Phase17 Live contracts and controls, not the Test enable flag. Never NEXT_PUBLIC.
SITEFIT_TEST_PURCHASES_ENABLED=
SITEFIT_PURCHASE_ORIGIN=
STRIPE_SECRET_KEY=
STRIPE_FULL_REPORT_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Phase 12 private verification only: set 1 for Local/protected Preview.
# This verification route is Production-denied; the separate stored dashboard is unchanged.
SITEFIT_REPORT_INTELLIGENCE_VERIFICATION=

# Phase14 machine-only Development/protected Preview; Phase17 commercial runner
# requires separate release, budget, supply and database authority in Production.
# SQL control/support allowlist default disabled; no operational paid allowance.
SITEFIT_FULFILMENT_ENABLED=
SITEFIT_FULFILMENT_RUNNER_SECRET=

# Phase16 optional session campaign measurement, Local/protected Preview only.
# Disabled by default; Production collection requires separate Phase17 authority.
SITEFIT_CAMPAIGN_MEASUREMENT=

# Phase17 staged commercial controls. Remain off until explicit activation/budgets,
# approved release/sale policies and private database controls also permit supply.
# Configure only in the intended Production scope; never copy Development DB/Test keys.
STRIPE_ACCOUNT_ID=
SITEFIT_COMMERCIAL_ENABLED=
SITEFIT_COMMERCIAL_EXECUTION=
SITEFIT_COMMERCIAL_SOURCE_COLLECTION=
SITEFIT_PUBLIC_INDEXING_ENABLED=

# Snapshot street-map display only; separate from generation. No implicit Production activation.
SITEFIT_SNAPSHOT_MAP_TILES_ENABLED=0
# Optional redacted saved-result review, branch-scoped to authenticated Preview only.
SITEFIT_SNAPSHOT_REVIEW=
SITEFIT_SNAPSHOT_REVIEW_ACCESS=
