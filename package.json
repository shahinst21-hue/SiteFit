{
  "name": "sitefit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "check:supabase": "node scripts/check-supabase.ts",
    "check:public": "node scripts/check-public-site.ts",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status"
  },
  "dependencies": {
    "@next/env": "^16.3.8",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "supabase": "^2.119.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.0"
  }
}
